# Stack environment variables for Portainer
HOST_PORT=3333
PORT=3000
NODE_ENV=production
TZ=Europe/Paris
APP_URL=http://localhost:3333

# Port Réception Syslog UDP (Host 514: Container 514/udp)
SYSLOG_UDP_PORT=514

# Variables d'automatisation Nebula (Portainer: Advanced settings > Env)
NEBULA_API_KEY=
NEBULA_ORG_ID=ORG-ZYXEL-FR-88412
NEBULA_SITE_ID=site-paris-hq
NEBULA_API_URL=https://zyxel.com

# Rétrocompatibilité
ZYXEL_NEBULA_ORG_ID=ORG-ZYXEL-FR-88412
ZYXEL_NEBULA_SITE_ID=site-paris-hq
ZYXEL_NEBULA_API_URL=https://zyxel.com
